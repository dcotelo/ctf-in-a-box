# Copy to .env.local and fill in real values. Never commit .env.local.

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app (callback: <BETTER_AUTH_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Leaderboard data source: mock (default) | lambda | upstash
LEADERBOARD_SOURCE=mock

# Base URL of the scoring API (serves /leaderboard and /challenges).
# Required when LEADERBOARD_SOURCE=lambda; the challenges page also uses it
# for the live challenge catalogue and falls back to static cards without it.
LEADERBOARD_API_URL=

# Used when LEADERBOARD_SOURCE=upstash, by team writes when
# TEAM_WRITES_ENABLED=true, and by paid hints (writes need a READ/WRITE
# token). Hint text lives only here, so without these hints cannot work at
# all — no organizer setting can turn them on.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# "true" makes team join/create/leave write real records to Upstash Redis
# (needs the UPSTASH_REDIS_REST_* vars above); unset uses a per-browser
# cookie mock instead.
TEAM_WRITES_ENABLED=

# "true" locks every module page (/challenges, /quiz, /flags, /ai and
# /profile) behind the pre-event password gate: visitors are redirected to
# /gate until they enter CHALLENGES_GATE_PASSWORD (verified server-side; 5
# wrong tries lock the IP for 24h via a Redis throttle). Needs
# BETTER_AUTH_SECRET (signs the unlock cookie). Flip to false and redeploy
# when the conference starts. The proxy covers PAGES only; the module routes
# that bank points or return challenge content (POST /api/quiz/answer,
# /api/classic/submit, /api/hints/reveal, the ai flag form) run their own
# requireGatePassed() check and answer 403 { error: "gate" } while locked.
# See README.md "Pre-event challenges gate".
CHALLENGES_GATE_ENABLED=
CHALLENGES_GATE_PASSWORD=
