/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Security-review artifacts, generated locally by the defending-code reference
# harness. These stay out of the repo on purpose: this repository is public,
# and the findings/triage files describe unpatched weaknesses in a site that is
# live during the event. Committing them would publish a to-do list for anyone
# looking to disrupt the CTF, before the fixes ship. Keep them local, land the
# fixes, and write up anything worth sharing after the event.
THREAT_MODEL.md
SECURITY-HANDOFF.md
VULN-FINDINGS.json
VULN-FINDINGS.md
TRIAGE.json
TRIAGE.md
PATCHES/
