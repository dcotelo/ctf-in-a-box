# DEPRECATED (issue #377): this is the push score-ingest variant, mounted when
# SCORE_INGEST=push. Push is deprecated in v0.6 and REMOVED in v0.7, together
# with this file and the `push` compose profile — poll is the score transport
# for secure-development, and Caddyfile.poll exposes no /score route at all.
# Until then this file keeps working unchanged; the headers below must stay
# identical to Caddyfile.poll's (AGENTS.md).
{$EVENT_HOST}

# Baseline security headers. HSTS only bites on HTTPS (Caddy auto-provisions TLS
# for a real domain in EVENT_HOST; it's inert on http://localhost).
header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	-Server
}

handle /score {
	reverse_proxy scorer:4000
}

handle {
	reverse_proxy app:3000
}
