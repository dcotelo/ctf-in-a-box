diff --git a/Dockerfile b/Dockerfile
new file mode 100644
index 0000000..657adfe
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,16 @@
+# Contestant-fork build: gradle-build the Spring Boot jar, then run it.
+# VulnerableApp forks ship Dockerfile.base + docker-compose (prebuilt images) but
+# no single root Dockerfile, so the patched-scores-right gate (which keys on a root
+# Dockerfile, like every other target's fork) adds this. It mirrors what the app's
+# own image does: bootJar on JDK 17, run on JRE 17, serving :9090/VulnerableApp
+# (server.port / server.servlet.context-path in application.properties).
+FROM eclipse-temurin:17-jdk AS build
+WORKDIR /src
+COPY . .
+RUN ./gradlew --no-daemon -x test -x spotlessCheck -x spotlessJavaCheck clean bootJar
+
+FROM eclipse-temurin:17-jre
+WORKDIR /app
+COPY --from=build /src/build/libs/VulnerableApp-1.0.0.jar /app/app.jar
+EXPOSE 9090
+ENTRYPOINT ["java", "-jar", "/app/app.jar"]
