# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

region        = "us-east-1"
instance_type = "t3.medium" # must be x86_64
name          = "ctf-in-a-box"

# Root EBS volume (GiB). The app + scorer image builds need headroom; 30 is the default.
# root_volume_gb = 30

# Existing EC2 key pair for SSH. Default is none — use SSM Session Manager instead.
# key_name = "my-keypair"

# Where the box clones the kit from. Point at your fork to run patched kit code.
# repo_url = "https://github.com/dcotelo/ctf-in-a-box.git"

# Pin a release tag for a real event.
git_ref = "v0.1.0"

# HTTPS requires a domain (Caddy auto-provisions TLS). Leave domain empty only
# for local/testing (HTTP on the EIP — session cookie is NOT Secure then).
domain          = "ctf.example.org"
# Set route53_zone_id only if the zone is in THIS account and you want Terraform
# to create the A record. Otherwise leave it empty and point your own A record
# (in any account) at the `public_ip` output.
route53_zone_id = ""

# Extra tags on every resource (on top of Project/ManagedBy/Event).
tags = {
  # Owner   = "you@example.org"
  # Expiry  = "2026-09-01"
}

# Public leaderboard by default; narrow for an organizer-only board.
web_ingress_cidrs = ["0.0.0.0/0"]
ssh_ingress_cidrs = [] # prefer SSM Session Manager; set ["1.2.3.4/32"] for SSH

# base64 of your event.yaml (NOT a secret):
#   event_yaml_b64 = filebase64("../../event.yaml")   # or paste a string
event_yaml_b64 = ""

# SSM path holding the SecureString SECRETS (create them out of band — see README).
ssm_prefix = "/ctf-in-a-box"
