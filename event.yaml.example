event:
  name: "OWASP Chapter CTF"
  start: 2026-10-01T09:00:00-03:00
  end: 2026-10-01T18:00:00-03:00
  url: http://192.168.1.10        # box URL contestants reach; public URL in push mode
  # discord: https://discord.gg/your-invite  # optional; omit to hide Discord links/mentions in the app
github:
  org: my-event-org                # disposable per-event org; also the fork org the app's challenge links point at
  oauth_client_id: Iv1.xxxx        # OAuth app client id (secret goes in .env)
modules:
  secure-development:
    targets: [juice-shop, dvwa]    # any subset of the six
    score_ingest: poll             # poll | push
  # quiz: {}                       # registrable today, but NOT YET IMPLEMENTED:
                                    # no UI, route, scoring, or admin controls
                                    # (phase 2) — see docs/modules.md §5
# A module is enabled by APPEARING under modules:. There is no `enabled:` key —
# omitting a module's block entirely is what disables it (and is why `quiz` is
# commented out above). A module's block holds only its own settings.
# v1 placeholders — not read at build time: team play is always on with a
# fixed 4-member cap, and hints (ON by default, 10 points each) are tuned at
# runtime in /admin — enabled, cost, and the two gating knobs. Remove hints
# entirely with HINTS_ENABLED=false in .env.
teams: { enabled: true, max_size: 4 }
hints: { enabled: true }
admins: [your-github-login]     # allowlist for /admin (status, freeze, hint controls) — case-insensitive
