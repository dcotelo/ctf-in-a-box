event:
  name: "OWASP Chapter CTF"
  start: 2026-10-01T09:00:00-03:00
  end: 2026-10-01T18:00:00-03:00
  # NO `url:` HERE. The event's URL is EVENT_URL, in .env — it is a DEPLOYMENT
  # fact, not an event one. The same event.yaml is deployed to a box, to AWS
  # and to fly.io on three different hostnames, which is why .env and .env.fly
  # carry different EVENT_URLs for one event. A `url:` in this file forced one
  # URL on all of them. Building with it set now fails and says so.
  # discord: https://discord.gg/your-invite  # optional; omit to hide Discord links/mentions in the app
github:
  org: my-event-org                # disposable per-event org; also the fork org the app's challenge links point at
                                   # (the OAuth app's client id and secret live in .env as
                                   # GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET, not here — see .env.example)
# The modules this event STARTS with, and the set it falls back to if Redis is
# unreachable — not the live truth. Quiz, Classic and AI can be switched on and
# off from /admin during the event, without a rebuild (issue #175), and
# editing this file mid-event changes nothing until you rebuild. Secure
# Development is the exception: it is configured HERE and only here, because
# it needs its scorer and sync services and its provisioned forks, none of
# which the app can conjure. See docs/operations.md and ADR 52.
modules:
  secure-development:
    targets: [juice-shop, dvwa]    # any subset of the six
    score_ingest: poll             # poll | push
  quiz: {}                         # single/multi-select question bank, scored
                                    # app-side (no targets/score_ingest of its
                                    # own — nothing to configure but presence).
                                    # Turns on: a "Quiz" nav link and /quiz page
                                    # for contestants; a Quiz section in /admin
                                    # to author questions (prompt, choices,
                                    # correct answer(s), points, order) and
                                    # tune the two retry-gate knobs (max
                                    # attempts, default 3; retry cooldown,
                                    # default 5 min); and quiz points added on
                                    # top of the combined leaderboard, deduped
                                    # per team by question. See
                                    # docs/operations.md's "Quiz" section and
                                    # docs/modules.md §5.
  classic: {}                      # jeopardy-style flag board, scored app-side
                                    # (no targets/score_ingest of its own —
                                    # nothing to configure but presence).
                                    # Turns on: a "Flags" nav link and /flags
                                    # page for contestants; a Classic section
                                    # in /admin to manage categories and author
                                    # challenges (title, category, Markdown
                                    # description, points, flag) and tune the
                                    # submission-cooldown knob (in SECONDS,
                                    # default 5, no attempt cap); and classic
                                    # points added on top of the combined
                                    # leaderboard, deduped per team by
                                    # challenge. A flag is stored in plaintext
                                    # and visible to anyone with /admin access.
                                    # See docs/operations.md's "Classic"
                                    # section and docs/modules.md §5.
  ai: {}                           # externally hosted AI/LLM challenges (no
                                    # targets/score_ingest of its own —
                                    # nothing to configure but presence).
                                    # Turns on: an "AI Challenges" nav link
                                    # and /ai page for contestants; an AI
                                    # section in /admin to author challenges
                                    # (mode flag/event/both, the external
                                    # launch URL, categories, an optional paid
                                    # hint) and tune the submission-cooldown
                                    # knob (aiCooldownSec, in SECONDS, default
                                    # 5); and ai points added on top of the
                                    # combined leaderboard, deduped per team by
                                    # challenge. Each challenge is hosted on a
                                    # site outside the box — the organizer
                                    # authors it here, but building or running
                                    # that external site is a separate job; see
                                    # docs/ai-module.md for what it must
                                    # implement to integrate. Adding the id
                                    # broke no existing config: every
                                    # event.yaml that was valid before still
                                    # is, and a running event needs no change.
                                    # See docs/modules.md §5.
# Don't want to write this file by hand? `./setup/ctf-setup.sh` (the wizard)
# asks which modules to enable and then asks only what those modules need —
# targets + score_ingest for secure-development, nothing for quiz, classic or
# ai — and writes the result here. An answer naming none of them emits no
# secure-development block at all.
#
# A module is enabled by APPEARING under modules:. There is no `enabled:` key —
# omitting a module's block entirely is what disables it. A module's block
# holds only its own settings (`quiz`'s, `classic`'s and `ai`'s have none yet,
# hence `{}`).
#
# `secure-development` is optional too — a single module is enough to run an
# event, and `quiz`/`classic` can run alone or together. A quiz-only event
# drops the block above entirely and looks like this
# (the `modules:` key itself must still be present — an event.yaml with no
# `modules:` block at all is rejected by both readers):
#
#   modules:
#     quiz: {}
#
# A classic-only event looks the same shape, just with `classic: {}` instead
# (or alongside it — `modules: { quiz: {}, classic: {} }` runs both app-side
# modules with no secure-development block at all).
#
# `sync` tolerates `secure-development` being absent (it exits cleanly with
# nothing to poll) and `ctf-setup.sh org`/`render`/`doctor` skip fork
# provisioning; `/challenges` 404s, and `/how-to-play`, `/rules`, the landing
# page, and the leaderboard all compose from whichever of `quiz`/`classic`/`ai`
# is enabled. See
# docs/hosting.md's "Configuration" section and docs/modules.md §7.
# NOTE: there is deliberately no `teams:` or `hints:` block here.
# Both used to live in this file and neither was ever read, which is worse than
# it sounds: a config saying `hints: { enabled: false }` served hints anyway,
# and one asking for `teams: { max_size: 6 }` got a cap of 4 — silently, in
# both cases. They are runtime settings now (ADR 31, ADRs 44-45): team
# registration, the per-team member cap, and every hint knob live in /admin.
# The wizard stopped emitting them, and `generate-event-config.mjs` warns if it
# finds them, so adding them back only earns a build warning.
admins: [your-github-login]     # bootstrap allowlist for /admin — case-insensitive.
                                # More admins are granted from the panel itself
                                # (Admins tab) without a rebuild; these are the
                                # ones baked in so somebody can get in first.
