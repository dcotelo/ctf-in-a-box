event:
  name: "OWASP CTF"                        # ignored since #386 — set from /admin → Event → Identity → Event name instead
  start: 2026-10-01T09:00:00-03:00
  end: 2026-10-01T18:00:00-03:00
  # NO `url:` HERE. The event's URL is EVENT_URL, in .env — it is a DEPLOYMENT
  # fact, not an event one. The same event.yaml is deployed to a box, to AWS
  # and to fly.io on three different hostnames, which is why .env and .env.fly
  # carry different EVENT_URLs for one event. A `url:` in this file forced one
  # URL on all of them. Building with it set now fails and says so.
  # theme: "Defend the supply chain"        # ignored since #386 — set from /admin → Event → Identity → Tagline instead
  # location: "Montevideo, Uruguay"         # ignored since #386 — set from /admin → Event → Identity → Location instead
  # contact: organizers@example.org         # ignored since #386 — set from /admin → Event → Identity → Contact e-mail instead
  # discord: https://discord.gg/your-invite # ignored since #386 — set from /admin → Event → Identity → Discord invite instead
github:
  org: my-event-org                # disposable per-event org; also the fork org the app's challenge links point at
                                   # (the OAuth app's client id and secret live in .env as
                                   # GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET, not here — see .env.example)
# `modules:` is SETUP-TIME config only. It configures secure-development's
# `score_ingest` — the only setup-time setting any module has left — and
# nothing else here enables or disables anything. Organizers switch
# Quiz, Classic, AI and Secure Development on and off from /admin during the
# event, without a rebuild (issue #175, ADR 52). The default set is
# secure-development alone when `SCORE_IMAGE` is set in .env, and nothing
# otherwise — a fresh box therefore shows "No boards are open yet." on the
# landing page until an organizer enables a board. See docs/operations.md's
# Event tab → Modules and docs/modules.md §1–2.
modules:
  secure-development:
    score_ingest: poll             # poll | push
  # quiz, classic and ai have no setup-time settings — there is nothing to
  # configure but presence, and presence configures nothing now either (see
  # docs/modules.md §5 and docs/operations.md's Quiz / Classic / AI
  # sections). Both readers (generate-event-config.mjs, sync) still accept a
  # `quiz: {}` / `classic: {}` / `ai: {}` block here if an older event.yaml
  # has one — it is inert, not wrong.
# `ctf-setup.sh org` provisions all six of `setup/targets.tsv`'s targets for
# every event that enables secure-development — always, unconditionally, no
# matter what (if anything) this file says. Which of the six contestants
# actually see, and which the sync poller reads, is chosen afterward, at
# runtime, from /admin → Secure Development → Targets — not from a
# `targets:` key here. A `targets:` key under `secure-development` is still
# accepted, in any shape, but every reader ignores it (#386 PR 2).
# Don't want to write this file by hand? `./setup/ctf-setup.sh` (the wizard)
# still writes this file and still asks which modules to enable — that answer
# writes one block per module named: `secure-development` with its
# `score_ingest`, and an empty `quiz: {}` / `classic: {}` / `ai: {}` for the
# others. None of those blocks enables anything any more: Quiz, Classic, AI
# and Secure Development are all switched on from /admin after the box is up.
# PR 3 of #386 removes the wizard's module question.
#
# Enablement lives in /admin now, not this file — see the comment above
# `modules:`. A quiz-only or classic-only event needs none of this file's
# module machinery: it has no `secure-development` block here, leaves
# `SCORE_IMAGE` empty in .env (so Secure Development is never even offered),
# and the organizer enables the Quiz or Classic board from /admin once the
# box is up.
#
# The one constraint this file still enforces: the `modules:` key itself
# must be present — an event.yaml with no `modules:` key at all is rejected
# by both readers (generate-event-config.mjs, sync).
#
# `sync` tolerates `secure-development` being absent (it exits cleanly with
# nothing to poll) and `ctf-setup.sh org`/`render`/`doctor` skip fork
# provisioning; `/challenges` 404s, and `/how-to-play`, `/rules`, the landing
# page, and the leaderboard all compose from whichever of `quiz`/`classic`/`ai`
# is enabled. See
# docs/hosting.md's "Configuration" section and docs/modules.md §7.
# NOTE: there is deliberately no `teams:` or `hints:` block here.
# Both used to live in this file and neither was ever read, which is worse than
# it sounds: a config saying `hints: { enabled: false }` served hints anyway,
# and one asking for `teams: { max_size: 6 }` got a cap of 4 — silently, in
# both cases. They are runtime settings now (ADR 31, ADRs 44-45): team
# registration, the per-team member cap, and every hint knob live in /admin.
# The wizard stopped emitting them, and `generate-event-config.mjs` warns if it
# finds them, so adding them back only earns a build warning.
admins: [your-github-login]     # bootstrap allowlist for /admin — case-insensitive.
                                # More admins are granted from the panel itself
                                # (Admins tab) without a rebuild; these are the
                                # ones baked in so somebody can get in first.
