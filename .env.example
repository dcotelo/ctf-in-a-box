# generated by: setup/ctf-setup.sh secrets
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PAT=            # organizer PAT, repo read on the event org (poll mode)
SRH_TOKEN=             # local Redis REST token (any random string)
SCORER_TOKEN=          # bearer token sync/push uses against POST /score
EVENT_URL=http://localhost
SCORE_INGEST=poll      # poll | push
# Your scorer image, built from scorer/ (see docs/scorer.md), e.g.
# ghcr.io/<your-event-org>/score:latest. The upstream ghcr.io/owasp-ctf/score
# is private and the kit does not assume access to it.
SCORE_IMAGE=
