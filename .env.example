# generated by: setup/ctf-setup.sh secrets
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PAT=            # organizer PAT, repo read on the event org (poll mode)
# --- Poll auth: EITHER a GITHUB_PAT above, OR a GitHub App (preferred) ---
# A GitHub App gives org-scoped, auto-expiring, revocable tokens (not tied to a
# person). Create one from sync/app-manifest.json, install it on the event org,
# then set these (private key base64-encoded: `base64 < app.private-key.pem`).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=          # base64-encoded PEM
GITHUB_APP_INSTALLATION_ID=      # optional; auto-discovered if the App has one installation
SRH_TOKEN=             # local Redis REST token (any random string)
SCORER_TOKEN=          # bearer token sync/push uses against POST /score
EVENT_URL=http://localhost
SCORE_INGEST=poll      # poll | push
# Your scorer image, built from scorer/ (see docs/scorer.md), e.g.
# ghcr.io/<your-event-org>/score:latest. The upstream ghcr.io/owasp-ctf/score
# is private and the kit does not assume access to it.
SCORE_IMAGE=
